{
  "info": {
    "_postman_id": "966ac339-32b0-4fb0-8692-439f62ac25e4",
    "name": "QA API Practice - JWT Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56673147",
    "_collection_link": "https://go.postman.co/collection/56673147-966ac339-32b0-4fb0-8692-439f62ac25e4?source=collection_link"
  },
  "item": [
    {
      "name": "POST Login - Obtain JWT Tokens",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login returns 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const loginResponse = pm.response.json();",
              "pm.environment.set(\"accessToken\", loginResponse.access_token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET Authenticated User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Authenticated user profile returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Profile belongs to logged in user\", function () {",
              "    const profile = pm.response.json();",
              "    pm.expect(profile.email).to.eql(pm.environment.get(\"demoEmail\"));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{accessToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "profile"
          ]
        }
      },
      "response": []
    },
    {
      "name": "GET User Profile - Missing Token (Negative)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Profile request without token returns 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "profile"
          ]
        }
      },
      "response": []
    }
  ]
}