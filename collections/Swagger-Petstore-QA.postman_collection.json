  "item": [
    {
      "name": "PET-001 Create pet - Valid data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseBody = pm.response.json();",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response Content-Type is JSON\", function () {",
              "    const contentType = pm.response.headers.get(\"Content-Type\");",
              "    pm.expect(contentType).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Created pet data is correct\", function () {",
              "    pm.expect(responseBody.id).to.be.a(\"number\");",
              "    pm.expect(responseBody.name).to.eql(\"Petch QA Dog\");",
              "    pm.expect(responseBody.photoUrls).to.include(",
              "        \"https://example.com/images/petch-qa-dog.jpg\"",
              "    );",
              "    pm.expect(responseBody.status).to.eql(\"available\");",
              "});",
              "",
              "pm.environment.set(\"petId\", String(responseBody.id));",
              "",
              "pm.test(\"Pet ID is saved to environment\", function () {",
              "    pm.expect(pm.environment.get(\"petId\"))",
              "        .to.eql(String(responseBody.id));",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{$timestamp}},\n  \"name\": \"Petch QA Dog\",\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"Dogs\"\n  },\n  \"photoUrls\": [\n    \"https://example.com/images/petch-qa-dog.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 1,\n      \"name\": \"portfolio\"\n    }\n  ],\n  \"status\": \"available\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pet",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pet"
          ]
        }
      },
      "response": []
    },
