    {
      "name": "PET-005 Find pets by status - Pending",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const pets = pm.response.json();",
              "const expectedPetId = pm.environment.get(\"petId\");",
              "",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array of pets\", function () {",
              "    pm.expect(pets).to.be.an(\"array\");",
              "});",
              "",
              "pm.test(\"Every returned pet has pending status\", function () {",
              "    const unexpectedPets = pets.filter(function (pet) {",
              "        return pet.status !== \"pending\";",
              "    });",
              "",
              "    pm.expect(unexpectedPets).to.have.lengthOf(0);",
              "});",
              "",
              "pm.test(\"Updated pet appears in pending results\", function () {",
              "    const petExists = pets.some(function (pet) {",
              "        return String(pet.id) === expectedPetId;",
              "    });",
              "",
              "    pm.expect(petExists).to.be.true;",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
